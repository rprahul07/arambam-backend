# ---------------------------------------------------------------------------
# Aarambam backend — environment
# Copy this file to `.env`. Every value below has a working default, so the
# API boots and serves the front end with no configuration at all.
# ---------------------------------------------------------------------------

# ---- Application ----------------------------------------------------------
NODE_ENV=development
PORT=5000
API_PREFIX=/api/v1
APP_NAME=Aarambam
# Where the React app is served from — used to build links inside emails.
CLIENT_URL=http://localhost:5173
# Public URL of this API — used for the URLs of uploaded images.
SERVER_URL=http://localhost:5000
# Browser origins allowed to call the API. Credentials are sent, so the SPA's
# origin must be listed here exactly.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173

# ---- Database -------------------------------------------------------------
# `pglite`   — PostgreSQL 16 embedded in this process, persisted to ./.data.
#              Zero configuration; the default when DATABASE_URL is unset.
# `postgres` — a real PostgreSQL / Supabase server (below). The schema and
#              every query are identical.
# DATABASE_DRIVER=postgres

# Supabase: Project Settings → Database → Connection string (URI).
DATABASE_URL=postgresql://postgres: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@db.xgsskzsbjuguovtveacs.supabase.co:5432/postgres
DATABASE_SSL=true
DB_POOL_MAX=10
# Where the embedded engine keeps its files. `:memory:` for a throwaway run.
# PGLITE_DATA_DIR=./.data/pglite

# ---- Authentication -------------------------------------------------------
# Required in production; the API refuses to start with the defaults.
JWT_ACCESS_SECRET=change-me-to-a-long-random-string
JWT_REFRESH_SECRET=change-me-to-another-long-random-string
JWT_ACCESS_EXPIRES_IN=30m
JWT_REFRESH_EXPIRES_IN=7d
JWT_REFRESH_DAYS=7
BCRYPT_SALT_ROUNDS=10
EMAIL_VERIFY_TOKEN_TTL_HOURS=24
PASSWORD_RESET_TOKEN_TTL_MINUTES=60

# The refresh cookie. Use `none` (and HTTPS) when the SPA is on a different
# site from the API; `lax` when they share one.
# COOKIE_SAME_SITE=lax
# COOKIE_DOMAIN=.aarambam.org

# ---- Demonstration --------------------------------------------------------
# The three one-click role buttons on the sign-in screen. Off in production.
DEMO_LOGIN_ENABLED=true
# The password every seeded account shares.
SEED_PASSWORD=Aarambam@2026

# ---- Email (SMTP) ---------------------------------------------------------
# Leave SMTP_HOST empty and every message is written to the log instead of
# being sent — which is what makes the sign-up and reset flows walkable
# locally without a mail server.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM_NAME=Aarambam
MAIL_FROM_ADDRESS=hello@aarambam.org
MAIL_PREVIEW_ONLY=true

# ---- Payment gateway ------------------------------------------------------
# `simulated` — the walkthrough build. Real rows, real receipts, no bank.
# `razorpay`  — production. A settlement is only believed once its HMAC
#               signature verifies against the key secret.
PAYMENT_PROVIDER=simulated
PAYMENT_CURRENCY=INR
# Minutes an unpaid seat is held before it goes back into the pool.
PAYMENT_HOLD_MINUTES=20

RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ---- Uploads --------------------------------------------------------------
UPLOAD_DIR=./uploads
UPLOAD_MAX_BYTES=5242880

# ---- Scheduled jobs -------------------------------------------------------
ENABLE_CRON=true
RENEWAL_REMINDER_DAYS=30
EVENT_REMINDER_HOURS=24

# ---- Rate limiting --------------------------------------------------------
RATE_LIMIT_WINDOW_MINUTES=15
RATE_LIMIT_MAX=1000
AUTH_RATE_LIMIT_MAX=30
WRITE_RATE_LIMIT_MAX=300

# ---- Logging --------------------------------------------------------------
# error | warn | info | debug
LOG_LEVEL=debug

# ---------------------------------------------------------------- storage ---
# Where uploaded images are kept: event covers, member photographs, payment QR
# codes and payment screenshots.
#
# Leave these blank and uploads go to the local disk, which is what a laptop
# wants. Set them in production: a container's filesystem does not survive a
# restart, and a member photograph must.
#
# The SERVICE ROLE key is required. An anonymous key is refused, because
# writing with one only works if the bucket accepts writes from anybody.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=aarambam-assets
